# Skopíruj tento súbor do .env a doplň skutočné hodnoty.
# POZOR: tieto VITE_ premenné sú v build-e viditeľné v prehliadači.
# Sem patrí LEN verejný (anon / publishable) Supabase kľúč – NIKDY service_role kľúč.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
